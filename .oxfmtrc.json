{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSameLine": true,
  "htmlWhitespaceSensitivity": "css",
  "ignorePatterns": [
    "*dist",
    "*generated",
    "packages/components/shared/src/vendor",
    "website",
    "runs/harness/fixtures",
    "runs/captures",
    "runs/probe-04"
  ],
  "insertFinalNewline": true,
  "jsdoc": true,
  "printWidth": 100,
  "singleQuote": true,
  "sortPackageJson": false,
  "tabWidth": 2,
  "trailingComma": "none"
}
