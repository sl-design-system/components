{
  "$schema": "./node_modules/@lit/localize-tools/config.schema.json",
  "sourceLocale": "en",
  "targetLocales": ["es-ES", "it", "nl", "pl"],
  "inputFiles": ["packages/components/**/*.ts"],
  "output": {
    "mode": "runtime",
    "outputDir": "packages/locales/src",
    "localeCodesModule": "packages/locales/src/locale-codes.ts"
  },
  "interchange": {
    "format": "xliff",
    "xliffDir": "packages/locales/src"
  }
}
