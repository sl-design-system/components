{
  "name": "@sl-design-system/avatar",
  "version": "1.3.2",
  "status": "stable",
  "description": "Avatar component for the SL Design System",
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": "./dist/index.js",
      "./register.js": "./dist/register.js",
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sl-design-system/components.git",
    "directory": "packages/components/avatar"
  },
  "homepage": "https://sanomalearning.design/components/avatar",
  "bugs": {
    "url": "https://github.com/sl-design-system/components/issues"
  },
  "type": "module",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "@sl-design-system/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./register.js": {
      "@sl-design-system/source": "./src/register.ts",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./src/register.ts",
    "./dist/register.js"
  ],
  "scripts": {
    "test": "echo \"Error: run tests from monorepo root.\" && exit 1"
  },
  "dependencies": {
    "@sl-design-system/badge": "^1.1.6",
    "@sl-design-system/shared": "^0.14.1",
    "@sl-design-system/tooltip": "^3.0.2"
  },
  "devDependencies": {
    "@lit/localize": "^0.12.2",
    "@open-wc/scoped-elements": "^3.0.10"
  },
  "peerDependencies": {
    "@lit/localize": "^0.12.1",
    "@open-wc/dedupe-mixin": "^2.0.1",
    "@open-wc/scoped-elements": "^3.0.10",
    "lit": "^3.1.4"
  }
}
