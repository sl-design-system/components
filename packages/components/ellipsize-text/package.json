{
  "name": "@sl-design-system/ellipsize-text",
  "version": "0.1.2",
  "status": "draft",
  "description": "Utility component that ellipsizes text if it doesn't fit",
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": "./dist/index.js",
      "./register.js": "./dist/register.js",
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sl-design-system/components.git",
    "directory": "packages/components/ellipsize-text"
  },
  "homepage": "https://sanomalearning.design/components/ellipsize-text",
  "bugs": {
    "url": "https://github.com/sl-design-system/components/issues"
  },
  "type": "module",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "@sl-design-system/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./register.js": {
      "@sl-design-system/source": "./src/register.ts",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "**/*.d.ts",
    "**/*.js",
    "**/*.js.map",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./src/register.ts",
    "./dist/register.js"
  ],
  "scripts": {
    "test": "echo \"Error: run tests from monorepo root.\" && exit 1"
  },
  "dependencies": {
    "@sl-design-system/tooltip": "^3.0.2"
  },
  "devDependencies": {
    "@open-wc/scoped-elements": "^3.0.10"
  },
  "peerDependencies": {
    "@open-wc/scoped-elements": "^3.0.10"
  }
}
