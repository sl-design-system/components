{
  "name": "@sl-design-system/format-number",
  "version": "0.0.11",
  "status": "preview",
  "description": "Number field component for the SL Design System",
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": "./dist/index.js",
      "./format.js": "./dist/format.js",
      "./register.js": "./dist/register.js",
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sl-design-system/components.git",
    "directory": "packages/components/format-number"
  },
  "homepage": "https://sanomalearning.design/components/format-number",
  "bugs": {
    "url": "https://github.com/sl-design-system/components/issues"
  },
  "type": "module",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "@sl-design-system/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./format.js": {
      "@sl-design-system/source": "./src/format.ts",
      "default": "./dist/format.js"
    },
    "./register.js": {
      "@sl-design-system/source": "./src/register.ts",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./src/register.ts",
    "./dist/register.js"
  ],
  "scripts": {
    "test": "echo \"Error: run tests from monorepo root.\" && exit 1"
  },
  "tsdown": {
    "entry": [
      "src/index.ts",
      "src/register.ts",
      "src/format.ts"
    ]
  },
  "dependencies": {
    "@sl-design-system/shared": "^0.14.1"
  },
  "peerDependencies": {
    "@open-wc/dedupe-mixin": "^2.0.1",
    "lit": "^3.1.4"
  }
}
