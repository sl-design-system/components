{
  "name": "@sl-design-system/grid",
  "version": "0.8.3",
  "status": "draft",
  "description": "Grid components for the SL Design System",
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": "./dist/index.js",
      "./register.js": "./dist/register.js",
      "./utils.js": "./dist/utils.js",
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sl-design-system/components.git",
    "directory": "packages/components/grid"
  },
  "homepage": "https://sanomalearning.design/components/grid",
  "bugs": {
    "url": "https://github.com/sl-design-system/components/issues"
  },
  "type": "module",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "@sl-design-system/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./register.js": {
      "@sl-design-system/source": "./src/register.ts",
      "default": "./dist/register.js"
    },
    "./utils.js": {
      "@sl-design-system/source": "./src/utils.ts",
      "default": "./dist/utils.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "**/*.d.ts",
    "**/*.js",
    "**/*.js.map",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./src/register.ts",
    "./dist/register.js"
  ],
  "tsdown": {
    "entry": [
      "src/index.ts",
      "src/register.ts",
      "src/utils.ts"
    ]
  },
  "scripts": {
    "test": "echo \"Error: run tests from monorepo root.\" && exit 1"
  },
  "dependencies": {
    "@sl-design-system/announcer": "^0.1.3",
    "@sl-design-system/button": "^2.3.1",
    "@sl-design-system/checkbox": "^2.4.2",
    "@sl-design-system/data-source": "^0.4.4",
    "@sl-design-system/ellipsize-text": "^0.1.2",
    "@sl-design-system/icon": "^1.4.5",
    "@sl-design-system/listbox": "^0.2.3",
    "@sl-design-system/scrollbar": "^0.1.4",
    "@sl-design-system/search-field": "^1.0.2",
    "@sl-design-system/select": "^2.4.2",
    "@sl-design-system/shared": "^0.14.1",
    "@sl-design-system/skeleton": "^1.1.2",
    "@sl-design-system/text-field": "^1.7.2",
    "@sl-design-system/toggle-group": "^1.0.1",
    "@sl-design-system/tool-bar": "^0.4.1",
    "@sl-design-system/tooltip": "^3.0.2"
  },
  "devDependencies": {
    "@lit-labs/virtualizer": "^2.1.1",
    "@lit/localize": "^0.12.2",
    "@open-wc/scoped-elements": "^3.0.10",
    "@sl-design-system/example-data": "^1.0.0",
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "@lit-labs/virtualizer": "^2.0.13",
    "@lit/localize": "^0.12.1",
    "@open-wc/scoped-elements": "^3.0.10",
    "lit": "^3.1.4"
  }
}
