{
  "name": "@sl-design-system/select",
  "version": "2.4.1",
  "status": "stable",
  "description": "Select component for the SL Design System",
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": "./dist/index.js",
      "./register.js": "./dist/register.js",
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sl-design-system/components.git",
    "directory": "packages/components/select"
  },
  "homepage": "https://sanomalearning.design/components/select",
  "bugs": {
    "url": "https://github.com/sl-design-system/components/issues"
  },
  "type": "module",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "@sl-design-system/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./register.js": {
      "@sl-design-system/source": "./src/register.ts",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "**/*.d.ts",
    "**/*.js",
    "**/*.js.map",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./src/register.ts",
    "./dist/register.js"
  ],
  "scripts": {
    "test": "echo \"Error: run tests from monorepo root.\" && exit 1"
  },
  "dependencies": {
    "@sl-design-system/form": "^1.5.1",
    "@sl-design-system/icon": "^1.4.5",
    "@sl-design-system/listbox": "^0.2.3",
    "@sl-design-system/shared": "^0.14.1"
  },
  "devDependencies": {
    "@lit/localize": "^0.12.2",
    "@open-wc/scoped-elements": "^3.0.10",
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "@lit/localize": "^0.12.1",
    "@open-wc/scoped-elements": "^3.0.10"
  }
}
