<section class="ds-tokens">
<h2 class="ds-tokens__heading">Color</h2>
{% for palette in tokens.palette -%}
<h3 class="ds-tokens__heading">{{ palette[0] }}</h3>
<table class="ds-table"><thead>
<tr>
  <th>Example</th>
  <th>Step</th>
  <th>Token</th>
</tr></thead>
<tbody>
{% for color in palette[1] -%}
<tr>
  <td>
    <div class="ds-tokens__color" style="background-color: {{ color.value }}"></div>
    <code>{{ color.value }}</code>
  </td>
  <td class="ds-tokens__description">{{ color.step }}</td>
  <td><code>{{ color.token }}</code></td>
</tr>
{% endfor -%}
</tbody>
</table>
{% endfor -%}
</section>
