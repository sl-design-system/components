<section class="ds-tokens">
<h2 class="ds-tokens__heading">Size</h2>
<table class="ds-table"><thead>
<tr>
  <th>Value</th>
  <th>Token</th>
</tr></thead>
<tbody>
{% for property in tokens.size -%}
<tr>
  <td>
    <div class="ds-tokens__size-example">
      <div class="ds-tokens__size" style="width: {{ property.value }}; height: {{ property.value }};"></div>
      <code>{{ property.value }}</code>
    </div>
  </td>
  <td><code>{{ property.token }}</code></td>
</tr>
{% endfor -%}
</tbody>
</table>
</section>
